# Copia este archivo como ".env" (o exporta estas variables en tu sistema)
# y ajusta los valores antes de desplegar en producción.

DJANGO_SECRET_KEY=cambia-esta-clave-por-una-segura
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Cambia a True para usar MySQL en lugar de SQLite
DJANGO_USE_MYSQL=False

MYSQL_DATABASE=helen_spa
MYSQL_USER=helen_spa_user
MYSQL_PASSWORD=una-contraseña-segura
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

